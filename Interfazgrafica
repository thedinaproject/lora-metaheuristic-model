function interfaz_ciudades_inteligentes()
  % Crear la figura principal
  fig = figure('Name', 'Optimización de Gateways', ...
               'NumberTitle', 'off', ...
               'Color', [0.9, 0.9, 0.9], ...
               'Position', [200, 200, 800, 500]);

  % Título principal
  uicontrol('Style', 'text', ...
            'String', 'Optimización de Gateways para Smart Cities', ...
            'FontSize', 14, ...
            'FontWeight', 'bold', ...
            'BackgroundColor', [0.9, 0.9, 0.9], ...
            'Position', [150, 460, 500, 40]);

  % Botones para cargar archivos
  uicontrol('Style', 'pushbutton', ...
            'String', 'Cargar Mapa de la Ciudad', ...
            'FontSize', 12, ...
            'Position', [50, 380, 200, 40], ...
            'Callback', @cargar_mapa_ciudad);
  uicontrol('Style', 'pushbutton', ...
            'String', 'Cargar Obstáculos', ...
            'FontSize', 12, ...
            'Position', [50, 320, 200, 40], ...
            'Callback', @cargar_mapa_obstaculos);
  uicontrol('Style', 'pushbutton', ...
            'String', 'Cargar Restricciones', ...
            'FontSize', 12, ...
            'Position', [50, 260, 200, 40], ...
            'Callback', @cargar_mapa_restricciones);

  % Reacomodamos los botones centrales

  % Número de antenas
  uicontrol('Style', 'text', ...
            'String', 'Número de Antenas:', ...
            'FontSize', 12, ...
            'BackgroundColor', [0.9, 0.9, 0.9], ...
            'Position', [300, 380, 200, 30]);
  entrada_antenas = uicontrol('Style', 'edit', ...
                              'FontSize', 12, ...
                              'String', '1', ...  % Valor inicial
                              'Position', [300, 350, 200, 30]);

  % Tecnología de la antena
  uicontrol('Style', 'text', ...
            'String', 'Tecnología de la Antena:', ...
            'FontSize', 12, ...
            'BackgroundColor', [0.9, 0.9, 0.9], ...
            'Position', [300, 290, 200, 30]);
  menu_tecnologia = uicontrol('Style', 'popupmenu', ...
                               'String', {'LoRa', 'Wi-Fi', 'LTE'}, ...
                               'FontSize', 12, ...
                               'Position', [300, 260, 200, 30]);

  % Tipo de cobertura
  uicontrol('Style', 'text', ...
            'String', 'Tipo de Cobertura:', ...
            'FontSize', 12, ...
            'BackgroundColor', [0.9, 0.9, 0.9], ...
            'Position', [300, 210, 200, 30]);
  menu_cobertura = uicontrol('Style', 'popupmenu', ...
                             'String', {'Omnidireccional', 'Direccional'}, ...
                             'FontSize', 12, ...
                             'Position', [300, 180, 200, 30]);

  % Barra para seleccionar el radio de la antena
  uicontrol('Style', 'text', ...
            'String', 'Radio de las Antenas (m):', ...
            'FontSize', 12, ...
            'BackgroundColor', [0.9, 0.9, 0.9], ...
            'Position', [300, 120, 200, 30]);
  slider_radio = uicontrol('Style', 'slider', ...
                           'Min', 100, 'Max', 15000, ...
                           'Value', 1000, ... % Valor inicial
                           'SliderStep', [0.0067, 0.1], ... % Incrementos visuales (aproximados)
                           'Position', [300, 90, 200, 30], ...
                           'Callback', @(src, event) mostrar_valor_radio(src));
  % Texto dinámico para mostrar el valor del slider
  texto_radio = uicontrol('Style', 'text', ...
                          'String', '1000 m', ...
                          'FontSize', 12, ...
                          'BackgroundColor', [0.9, 0.9, 0.9], ...
                          'Position', [510, 90, 80, 30]);

  % Botón para optimizar
  uicontrol('Style', 'pushbutton', ...
            'String', 'OPTIMIZAR', ...
            'FontSize', 14, ...
            'FontWeight', 'bold', ...
            'BackgroundColor', [0.7, 0.9, 0.7], ...
            'Position', [300, 20, 200, 50], ...
            'Callback', @(src, event) optimizar(entrada_antenas, slider_radio, menu_cobertura, menu_tecnologia));

  % Funciones callback
  function cargar_mapa_ciudad(~, ~)
    [file, path] = uigetfile('*.csv', 'Seleccionar el archivo CSV del mapa de la ciudad');
    if file
        ciudad_data = readtable(fullfile(path, file));
        disp('Mapa de la ciudad cargado:');
        disp(ciudad_data);
        % Procesar el archivo CSV según sea necesario
    end
  end

  function cargar_mapa_obstaculos(~, ~)
    [file, path] = uigetfile('*.csv', 'Seleccionar el archivo CSV de obstáculos');
    if file
        obstaculos_data = readtable(fullfile(path, file));
        disp('Mapa de obstáculos cargado:');
        disp(obstaculos_data);
        % Procesar el archivo CSV según sea necesario
    end
  end

  function cargar_mapa_restricciones(~, ~)
    [file, path] = uigetfile('*.csv', 'Seleccionar el archivo CSV de restricciones');
    if file
        restricciones_data = readtable(fullfile(path, file));
        disp('Mapa de restricciones cargado:');
        disp(restricciones_data);
        % Procesar el archivo CSV según sea necesario
    end
  end

  function mostrar_valor_radio(slider)
    % Redondear el valor del slider al múltiplo más cercano de 100
    valor = round(get(slider, 'Value') / 100) * 100;
    set(texto_radio, 'String', sprintf('%.0f m', valor));
    set(slider, 'Value', valor); % Actualizar el slider al valor redondeado
  end

  function optimizar(entrada, slider, menu, menu_tecnologia)
    % Verificar si todos los campos están completos
    numero_antenas = str2double(get(entrada, 'String'));
    radio_antenas = get(slider, 'Value');
    tipo_cobertura = get(menu, 'Value');
    tipo_antena = get(menu_tecnologia, 'Value');

    % Verificar si hay algún campo vacío o incorrecto
    if isempty(numero_antenas) || isnan(numero_antenas) || numero_antenas <= 0
        errordlg('Por favor, ingresa un número válido de antenas.', 'Error');
        return;
    end

    if radio_antenas < 100 || radio_antenas > 15000
        errordlg('Por favor, selecciona un radio de antena válido entre 100 y 15000 metros.', 'Error');
        return;
    end

    if tipo_cobertura == 0
        errordlg('Por favor, selecciona un tipo de cobertura.', 'Error');
        return;
    end

    if tipo_antena == 0
        errordlg('Por favor, selecciona un tipo de antena.', 'Error');
        return;
    end

    % Si todos los campos están completos, realizar la optimización
    opciones_cobertura = {'Omnidireccional', 'Direccional'};
    opciones_antena = {'LoRa', 'Wi-Fi', 'LTE'};

    disp(['Número de antenas: ', num2str(numero_antenas)]);
    disp(['Radio de antenas: ', num2str(radio_antenas), ' m']);
    disp(['Tipo de Cobertura: ', opciones_cobertura{tipo_cobertura}]);
    disp(['Tipo de Antena: ', opciones_antena{tipo_antena}]);


    % Aquí puedes agregar la lógica de optimización
  end
end
